# Copy to .env.local and fill in. Add the same names in Vercel → Settings → Environment Variables.

# Neon Postgres connection string
DATABASE_URL=

# Resend: API key, and the inbox that receives new inquiries
RESEND_API_KEY=
BOOKING_EMAIL=

# Better Auth: generate the secret with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Use a different secret per environment.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Public "from" prices on the packages section (whole dollars). Leave blank to hide a line.
PRICE_FROM=
PRICE_RANGE_LOW=
PRICE_RANGE_HIGH=

# The only account allowed into /inquiries
OWNER_EMAIL=
